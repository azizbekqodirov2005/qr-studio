# Supabase project settings (Project Settings → API).
# The anon key is a PUBLIC key by design: access is enforced by Row Level Security.
# Never put the service_role key in this file or anywhere in frontend code.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Public base URL of the deployed app. QR codes for Social / Business / Gallery pages
# point to `${VITE_PUBLIC_SITE_URL}/p/<slug>` etc. Falls back to the current origin.
VITE_PUBLIC_SITE_URL=https://qr-studio.example.com
